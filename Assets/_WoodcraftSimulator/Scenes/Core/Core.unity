    displayNameTurkish: "F\u0131r\xE7as\u0131z \u015Farjl\u0131 matkap"
    effect: drills and drives 60 % faster
    effectTurkish: "%60 daha h\u0131zl\u0131 deler ve vidalar"
    priceEuros: 80
    requiredRank: 1
  - id: lamp-led
    displayName: LED workshop lamp
    displayNameTurkish: "LED at\xF6lye lambas\u0131"
    effect: brighter bench light
    effectTurkish: "tezgahta daha parlak \u0131\u015F\u0131k"
    priceEuros: 30
    requiredRank: 0
  - id: sawhorses-2
    displayName: Second pair of sawhorses
    displayNameTurkish: "\u0130kinci sehpa tak\u0131m\u0131"
    effect: cut and lay out two boards at once
    effectTurkish: "ayn\u0131 anda iki tahtayla \xE7al\u0131\u015F"
    priceEuros: 40
    requiredRank: 1
