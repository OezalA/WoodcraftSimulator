  m_Script: {fileID: 11500000, guid: 537f385b4d91875408760371ee5ea153, type: 3}
  m_Name: Job_ToolTote
  m_EditorClassIdentifier: WoodcraftSimulator::WoodcraftSimulator.Jobs.JobDefinition
  id: tool-tote-job
  displayName: Tool tote
  description: 'An open tool tote from 18 mm spruce: doweled and glued base, nailed
    sides, screwed handle, sanded and oiled.'
  blueprint: {fileID: 11400000, guid: 1ea0ef9cc7358e14bb0da64916527bad, type: 2}
  stockSpecies: {fileID: 11400000, guid: dca24a1dc39899146a557f009cce814a, type: 2}
  stockLengthMillimeters: 2000
  stockWidthMillimeters: 145
  stockThicknessMillimeters: 18
  spareBoards: 0
  tips:
  - 'Rip the sides (100 mm) and the handle (45 mm): saw in hand, Q for rip mode,
    the wheel sets the width.'
  - 'Ends to base: drill the dowel holes, glue the dowels in, then let the clamped
    joint dry.'
  - 'The nails near the ends of the sides are red points: pre-drill them, or the
    sides split.'
  - Sand, then oil every part for the full pay.
  payEuros: 90
  requiresFinish: 1
  extraStocks: []
  depositShare: 0
  requiredRank: 1
  needsSkill: 0
  requiredSkill: 0
  requiredSkillLevel: 1
