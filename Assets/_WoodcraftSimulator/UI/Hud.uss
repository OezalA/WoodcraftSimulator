/* Full-screen container; centers the crosshair. */
.hud-root {
    position: absolute;
    left: 0px;
    top: 0px;
    right: 0px;
    bottom: 0px;
    align-items: center;
    justify-content: center;
}

.crosshair {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.8);
}

/* Something interactable is under the crosshair. */
.crosshair--focused {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: rgb(255, 214, 140);
}

/* Positioned below the crosshair without shifting it. */
.prompt-anchor {
    position: absolute;
    left: 0px;
    right: 0px;
    top: 54%;
    align-items: center;
}

.interaction-prompt {
    font-size: 22px;
    color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0.55);
    padding: 6px 14px;
    border-radius: 4px;
    -unity-text-align: middle-center;
}

/* Tool readout above the crosshair (e.g. "623 mm"). */
.readout-anchor {
    position: absolute;
    left: 0px;
    right: 0px;
    bottom: 54%;
    align-items: center;
}

.tool-readout {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(255, 230, 120);
    background-color: rgba(0, 0, 0, 0.55);
    padding: 4px 14px;
    border-radius: 4px;
    -unity-text-align: middle-center;
}

/* Tool belt bar at the bottom center. */
.belt {
    position: absolute;
    left: 0px;
    right: 0px;
    bottom: 28px;
    flex-direction: row;
    justify-content: center;
}

.belt-slot {
    width: 190px;
    height: 42px;
    margin-left: 4px;
    margin-right: 4px;
    font-size: 17px;
    color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0.45);
    border-radius: 4px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-center;
}

.belt-slot--empty {
    color: rgba(255, 255, 255, 0.35);
}

.belt-slot--selected {
    border-color: rgb(255, 214, 140);
    background-color: rgba(70, 52, 24, 0.75);
}

/* Quality report of a completed assembly: right side, below the top edge. */
.report-anchor {
    position: absolute;
    right: 40px;
    top: 18%;
    width: 560px;
}

.assembly-report {
    font-size: 18px;
    color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0.65);
    padding: 12px 16px;
    border-radius: 6px;
    border-left-width: 4px;
    border-left-color: rgb(120, 200, 120);
    white-space: normal;
    -unity-text-align: upper-left;
}

/* Job sheet: top left, small enough to stay out of the way while working. */
.job-anchor {
    position: absolute;
    left: 24px;
    top: 24px;
    width: 480px;
}

.job-sheet {
    font-size: 15px;
    color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0.55);
    padding: 10px 14px;
    border-radius: 6px;
    border-left-width: 4px;
    border-left-color: rgb(230, 180, 90);
    white-space: normal;
    -unity-text-align: upper-left;
}

/* Job card of the active job (D-051): sections separated by thin lines, small caps headings, the cut list as a
   table. Built from code by JobPanel. Colours: amber = job accent / started, green = done, grey = not started. */
.job-card {
    width: 460px;
    padding: 12px 16px 14px 16px;
    background-color: rgba(16, 14, 12, 0.82);
    border-radius: 8px;
    border-left-width: 4px;
    border-left-color: rgb(230, 180, 90);
}

.job-card Label {
    margin: 0px;
    padding: 0px;
    color: rgba(255, 255, 255, 0.85);
    font-size: 13px;
}

.job-card__header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.job-card .job-card__eyebrow {
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    color: rgb(230, 180, 90);
}

.job-card .job-card__time {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.6);
}

.job-card .job-card__title {
    margin-top: 2px;
    font-size: 21px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.job-card .job-card__description {
    margin-top: 2px;
    color: rgba(255, 255, 255, 0.6);
    white-space: normal;
}

.job-card__section {
    margin-top: 10px;
    padding-top: 8px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.12);
}

.job-card__heading {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.job-card .job-card__heading-title {
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1.2px;
    color: rgba(230, 180, 90, 0.9);
}

.job-card .job-card__heading-value {
    margin-left: 6px;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.6);
}

.job-card__spacer {
    flex-grow: 1;
}

.job-card .job-card__stage-name {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.job-card__bar {
    height: 6px;
    margin-top: 6px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.12);
    overflow: hidden;
}

.job-card__bar-fill {
    height: 100%;
    width: 0%;
    border-radius: 3px;
    background-color: rgb(230, 180, 90);
}

.job-card__bar-fill--done {
    background-color: rgb(120, 200, 120);
}

.job-card .job-card__note {
    margin-top: 5px;
    font-size: 12px;
    color: rgb(255, 200, 120);
}

.cut-row {
    flex-direction: row;
    align-items: center;
    height: 22px;
}

.cut-row__dot {
    width: 9px;
    height: 9px;
    margin-right: 8px;
    border-radius: 5px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.45);
    flex-shrink: 0;
}

.cut-row__dot--started {
    background-color: rgb(230, 180, 90);
    border-color: rgb(230, 180, 90);
}

.cut-row__dot--done {
    background-color: rgb(120, 200, 120);
    border-color: rgb(120, 200, 120);
}

.job-card .cut-row__qty {
    width: 30px;
    margin-right: 6px;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    color: rgb(255, 255, 255);
    flex-shrink: 0;
}

.job-card .cut-row__size {
    width: 142px;
    flex-shrink: 0;
}

.job-card .cut-row__name {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0px;
    color: rgba(255, 255, 255, 0.65);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.job-card .cut-row__status {
    margin-left: 8px;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.65);
    -unity-text-align: middle-right;
    flex-shrink: 0;
}

.job-card .cut-row__status--done {
    color: rgb(120, 200, 120);
}

.job-card .job-card__line {
    margin-top: 1px;
}

.job-card__tip {
    flex-direction: row;
    margin-top: 4px;
}

.job-card__tip-mark {
    width: 3px;
    margin-right: 8px;
    border-radius: 1px;
    background-color: rgba(230, 180, 90, 0.55);
    flex-shrink: 0;
}

.job-card .job-card__tip-text {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.65);
    white-space: normal;
}

.money-anchor {
    position: absolute;
    right: 24px;
    top: 20px;
}

.money {
    font-size: 17px;
    color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0.55);
    padding: 6px 12px;
    border-radius: 6px;
    border-left-width: 4px;
    border-left-color: rgb(120, 180, 230);
}

.inventory-anchor {
    position: absolute;
    left: 30%;
    top: 12%;
    width: 560px;
}

.inventory {
    font-size: 16px;
    color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0.78);
    padding: 12px 16px;
    border-radius: 6px;
    border-left-width: 4px;
    border-left-color: rgb(120, 180, 230);
    white-space: normal;
}

.hidden {
    display: none;
}
