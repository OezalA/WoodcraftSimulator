/* Full-screen container; centers the crosshair. */
.hud-root {
    position: absolute;
    left: 0px;
    top: 0px;
    right: 0px;
    bottom: 0px;
    align-items: center;
    justify-content: center;
}

.crosshair {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.8);
}

/* Something interactable is under the crosshair. */
.crosshair--focused {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: rgb(255, 214, 140);
}

/* Positioned below the crosshair without shifting it. */
.prompt-anchor {
    position: absolute;
    left: 0px;
    right: 0px;
    top: 54%;
    align-items: center;
}

.interaction-prompt {
    font-size: 22px;
    color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0.55);
    padding: 6px 14px;
    border-radius: 4px;
    -unity-text-align: middle-center;
}

/* Tool readout above the crosshair (e.g. "623 mm"). */
.readout-anchor {
    position: absolute;
    left: 0px;
    right: 0px;
    bottom: 54%;
    align-items: center;
}

.tool-readout {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(255, 230, 120);
    background-color: rgba(0, 0, 0, 0.55);
    padding: 4px 14px;
    border-radius: 4px;
    -unity-text-align: middle-center;
}

/* Tool belt bar at the bottom center. */
.belt {
    position: absolute;
    left: 0px;
    right: 0px;
    bottom: 28px;
    flex-direction: row;
    justify-content: center;
}

.belt-slot {
    width: 190px;
    height: 42px;
    margin-left: 4px;
    margin-right: 4px;
    font-size: 17px;
    color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0.45);
    border-radius: 4px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-center;
}

.belt-slot--empty {
    color: rgba(255, 255, 255, 0.35);
}

.belt-slot--selected {
    border-color: rgb(255, 214, 140);
    background-color: rgba(70, 52, 24, 0.75);
}

/* Quality report of a completed assembly: right side, below the top edge. */
.report-anchor {
    position: absolute;
    right: 40px;
    top: 18%;
    width: 560px;
}

.assembly-report {
    font-size: 18px;
    color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0.65);
    padding: 12px 16px;
    border-radius: 6px;
    border-left-width: 4px;
    border-left-color: rgb(120, 200, 120);
    white-space: normal;
    -unity-text-align: upper-left;
}

/* Job sheet: top left, small enough to stay out of the way while working. */
.job-anchor {
    position: absolute;
    left: 24px;
    top: 24px;
    width: 480px;
}

.job-sheet {
    font-size: 15px;
    color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0.55);
    padding: 10px 14px;
    border-radius: 6px;
    border-left-width: 4px;
    border-left-color: rgb(230, 180, 90);
    white-space: normal;
    -unity-text-align: upper-left;
}

.hidden {
    display: none;
}
