<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Hud.uss" />
    <ui:VisualElement name="hud-root" class="hud-root" picking-mode="Ignore">
        <ui:VisualElement name="crosshair" class="crosshair" picking-mode="Ignore" />
        <ui:VisualElement name="prompt-anchor" class="prompt-anchor" picking-mode="Ignore">
            <ui:Label name="interaction-prompt" class="interaction-prompt hidden" picking-mode="Ignore" text="" />
        </ui:VisualElement>
        <!-- Live text of the tool in hand (e.g. tape measure reading), above the crosshair. -->
        <ui:VisualElement name="readout-anchor" class="readout-anchor" picking-mode="Ignore">
            <ui:Label name="tool-readout" class="tool-readout hidden" picking-mode="Ignore" text="" />
        </ui:VisualElement>
        <!-- Tool belt slots are created from code (slot count comes from PlayerToolBelt). -->
        <ui:VisualElement name="belt" class="belt" picking-mode="Ignore" />
        <!-- Quality report of a completed assembly, shown for a while on the right. -->
        <ui:VisualElement name="report-anchor" class="report-anchor" picking-mode="Ignore">
            <ui:Label name="assembly-report" class="assembly-report hidden" picking-mode="Ignore" text="" />
            <!-- Result of the active job once its structure is complete (stays until delivered). -->
            <ui:Label name="job-result" class="assembly-report hidden" picking-mode="Ignore" text="" />
        </ui:VisualElement>
        <!-- Money (top right) and the workshop inventory (Tab), D-040. -->
        <ui:VisualElement name="money-anchor" class="money-anchor" picking-mode="Ignore">
            <ui:Label name="money" class="money" picking-mode="Ignore" text="" />
        </ui:VisualElement>
        <ui:VisualElement name="inventory-anchor" class="inventory-anchor" picking-mode="Ignore">
            <ui:Label name="inventory" class="inventory hidden" picking-mode="Ignore" text="" />
        </ui:VisualElement>
        <!-- Job card of the active job (built from code by JobPanel, D-051), or the offer of the sheet being looked at. -->
        <ui:VisualElement name="job-anchor" class="job-anchor" picking-mode="Ignore">
            <ui:VisualElement name="job-card" class="job-card hidden" picking-mode="Ignore" />
            <ui:Label name="job-sheet" class="job-sheet hidden" picking-mode="Ignore" text="" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
